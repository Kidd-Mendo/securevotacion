# Configuración de Base de Datos
DATABASE_URL=tu_url_de_postgresql

# Configuración de JWT (¡IMPORTANTE! Cambia esto en producción)
JWT_SECRET=tu-clave-secreta-super-segura-cambiala-en-produccion

# Configuración del Servidor
NODE_ENV=production
PORT=5000

# Configuración de CORS (lista separada por comas)
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# Configuración de Email (para recuperación de contraseña - opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicación
# SMTP_FROM=noreply@tudominio.com
